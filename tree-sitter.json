{
  "grammars": [
    {
      "name": "ssl",
      "camelcase": "Ssl",
      "scope": "source.ssl",
      "path": ".",
      "file-types": [
        "ssl"
      ],
      "highlights": "queries/ssl/highlights.scm",
      "locals": "queries/ssl/locals.scm",
      "injection-regex": "^ssl$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for SSL (Star-Trek Scripting Language / Fallout Script)",
    "links": {
      "repository": "https://github.com/Urbs97/tree-sitter-ssl"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
